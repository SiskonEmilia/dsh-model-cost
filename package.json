{
  "name": "dsh-model-cost",
  "version": "0.1.0",
  "description": "Per-Session and global model spend for DeepSeek Harness, priced with the LiteLLM Model Cost Map including its peak/off-peak windows.",
  "license": "MIT",
  "author": "SiskonEmilia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiskonEmilia/dsh-model-cost.git"
  },
  "homepage": "https://github.com/SiskonEmilia/dsh-model-cost#readme",
  "bugs": {
    "url": "https://github.com/SiskonEmilia/dsh-model-cost/issues"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./pricing": "./pricing.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "pricing.js",
    "usage.js",
    "cache.js",
    "cordis.patch.yml",
    "data/cost-map.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true }
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
